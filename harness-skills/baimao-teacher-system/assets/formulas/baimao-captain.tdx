X1:=(CLOSE*2+HIGH+LOW)/4*10;
X2:=EMA(X1,13)-EMA(X1,34);
X3:=EMA(X2,5);
X4:=2*(X2-X3)*5.5;
X5:=IF(X4<=0,X4,0);
X6:=IF(X4>=0,X4,0);
IDXRG:=MAX(HHV(INDEXH,8)-LLV(INDEXL,8),0.0001);
X7:=(HHV(INDEXH,8)-INDEXC)/IDXRG*8;
X8:=EMA(3*X7-2*SMA(X7,18,1),5);
X9:=(INDEXC-LLV(INDEXL,8))/IDXRG*10;
X10:=(INDEXC*2+INDEXH+INDEXL)/4;
X11:=EMA(X10,13)-EMA(X10,34);
X12:=EMA(X11,3);
X13:=(X11-X12)/2;
X14:=IF(X13>=0,X13,0);
X15:=IF(X13<=0,X13,0);
RANGE55:=MAX(HHV(HIGH,55)-LLV(LOW,55),0.0001);
X16:=3*SMA((CLOSE-LLV(LOW,55))/RANGE55*100,5,1)-2*SMA(SMA((CLOSE-LLV(LOW,55))/RANGE55*100,5,1),3,1);
白猫数值:EMA(X16,3);
X17:=(白猫数值-REF(白猫数值,1))/MAX(ABS(REF(白猫数值,1)),0.0001)*100;
即将反弹:STICKLINE(白猫数值<=13,0,20,5,0),COLORRED;
X18:=白猫数值<=13 AND FILTER(白猫数值<=13,15);
开始反弹:STICKLINE(白猫数值<=13 AND X17>13,0,50,5,0),COLORYELLOW;
X19:=白猫数值<=13 AND X17>13 AND FILTER(白猫数值<=13 AND X17>13,10);
卖临界:STICKLINE(白猫数值>90 AND 白猫数值>REF(白猫数值,1),100,95,15,1),COLORCYAN;
风险信号:FILTER(白猫数值>90 AND 白猫数值<REF(白猫数值,1) AND X6<REF(X6,1),8),COLORGREEN;
X20:=白猫数值>=90 AND X17<>0 AND FILTER(白猫数值>=90 AND X17<>0,10);
STICKLINE(X14>0 AND 白猫数值<13,0,30,10,0),COLORRED;
STICKLINE(X15<0 AND 白猫数值>90,0,30,10,0),COLORGREEN;
STICKLINE(X6>0 AND 白猫数值<13,0,40,10,0),COLORMAGENTA;
STICKLINE(X5<0 AND 白猫数值>90,0,40,10,0),COLORBLUE;


