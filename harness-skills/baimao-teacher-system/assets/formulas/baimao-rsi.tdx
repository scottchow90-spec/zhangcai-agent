UP1:=(C>O OR C>REF(C,1)) AND V>REF(V,1);
AA:=COUNT(UP1,3)=3;
BB:=LLV(L,5)=LLV(L,120);
CC:=C>MA(C,3);
LLT:=AA AND BB AND CC;
V1:=LLV(LOW,10);
V2:=HHV(H,25);
短线卖出:3.2;
极度风险:3.5,COLORBLUE;
趋势线:EMA(IF(V2=V1,0,(C-V1)/(V2-V1)*4),4);
M5:=MA(趋势线,5);
超卖区域:0.3,COLORYELLOW;
VAR2:=IF(EMA(CLOSE,5)/MAX(EMA(EMA(CLOSE,9),16),0.0001)<=0.85 AND CLOSE/REF(CLOSE,1)>0.905 AND CLOSE/REF(CLOSE,1)<1.05 AND VOL/MAX(CAPITAL,1)*100<5,50,0);
VAR3:=(-100)*(HHV(HIGH,34)-CLOSE)/MAX(HHV(HIGH,34)-LLV(LOW,34),0.0001)+100;
VAR4:=(-100)*(HHV(HIGH,50)-CLOSE)/MAX(HHV(HIGH,50)-LLV(LOW,50),0.0001)+100;
VAR5:=(-100)*(HHV(HIGH,70)-CLOSE)/MAX(HHV(HIGH,70)-LLV(LOW,70),0.0001)+100;
VAR6:=((CLOSE-MA(CLOSE,34))/MAX(MA(CLOSE,34),0.0001)*100+10)*5;
VAR7:=((CLOSE-MA(CLOSE,50))/MAX(MA(CLOSE,50),0.0001)*100+10)*5;
VAR8:=((CLOSE-MA(CLOSE,70))/MAX(MA(CLOSE,70),0.0001)*100+10)*5;
VAR9:=(VAR3+VAR4+VAR5+VAR6+VAR7+VAR8)/6;
VARA:=EMA(VAR9,3);
VARB:=ABS(VAR6-VAR8);
VARC:=(VAR9+VARB)/2;
VARD:=(-1)*(EMA(100*(1-WINNER(CLOSE)),1)-50)+50;
VARE:=VARD+VARC;
VARF:=IF(VAR2>0 AND VARE<0,200,0);
VAR10:=IF(VARC<0 AND CLOSE=LLV(CLOSE,5) AND CLOSE/REF(CLOSE,1)>0.905 AND CLOSE/REF(CLOSE,1)<1.05 AND VOL/MAX(CAPITAL,1)*100<5,-50,0);
VAR11:=IF(VARE<0 AND VAR10=-50,100,0);
VAR12:=MA(CLOSE,3);
VAR13:=REF(CLOSE,2)*0.865;
VAR14:=REF(CLOSE,13)*0.772;
VAR15:=MIN(VAR13,VAR14);
VAR16:=100*VOL/MAX(CAPITAL,1);
VAR17:=MA(CLOSE,13);
VAR18:=IF((CLOSE-VAR15)/MAX(CLOSE,0.0001)<0.03 AND SUM(VAR16,5)/5<1.8,1,0);
VAR19:=IF(VAR18>0 AND (VAR10<0 OR VAR2>0),100,0);
VAR1A:=VAR19;
VAR1B:=IF((VARF>0 AND VAR11>0 AND SUM(VOL/MAX(CAPITAL,1)*100,5)/5<1) OR (VAR18>0 AND REF(CLOSE,1)/REF(CLOSE,2)>0.902) OR (((VARF>0 AND VAR11>0 AND SUM(VOL/MAX(CAPITAL,1)*100,5)/5<1) OR VAR18>0) AND (VAR10<0 OR VAR2>0) AND VAR19<10),50,0);
VAR1C:=((VARF>0 AND VAR11>0 AND SUM(VOL/MAX(CAPITAL,1)*100,5)/5<1) OR VAR18>0) AND (VAR10<0 OR VAR2>0);
VAR1D:=(VARF>0 AND VAR11>0 AND SUM(VOL/MAX(CAPITAL,1)*100,5)/5<1) OR (VAR18>0 AND REF(CLOSE,1)/REF(CLOSE,2)>0.902);


