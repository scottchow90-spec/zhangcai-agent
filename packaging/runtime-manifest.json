{
  "schema": "ZHANGCAI_4319_DESKTOP_PACKAGE_PLAN_V2",
  "product": "掌财桌面端",
  "packageVersion": "0.1.13",
  "scope": "current-4319-3003-3004-main-program",
  "releaseMode": "integrated-main-installer-plus-program-update",
  "packagingPolicy": {
    "spec": "packaging/main-installer-policy.json",
    "mainInstallerBypassesDataPack": true,
    "baselineRuntimeEmbedded": true,
    "programUpdatesReuseBaseline": true,
    "dataPackMode": "optional-post-install"
  },
  "releaseLayers": {
    "environmentBaseline": "dist-installer/releases/0.1.13/掌财桌面端-0.1.13-x64.exe",
    "environmentBaselineVersion": "packaging/environment-baseline-version.txt",
    "environmentBaselineReusable": true,
    "mainProgram": "dist-installer/releases/0.1.13/掌财桌面端-0.1.13-x64.exe",
    "mainProgramRequiresEnvironment": false,
    "mainProgramContains": ["Electron", "private Node.js", "private Python", "DeepSeek Harness", "pruned Vinext runtime dependencies"],
    "programUpdate": "dist-installer/releases/0.1.13/掌财桌面端-程序更新-0.1.13-x64.exe",
    "programUpdateExcludes": ["resources/runtime", "resources/deepseek-harness", "resources/app/node_modules", "data/resource-library"],
    "legacyEnvironmentArtifacts": [
      "dist-installer/releases/0.1.6/掌财桌面端-运行环境-0.1.6-x64.exe",
      "dist-installer/releases/0.1.6/掌财桌面端-运行环境卸载-0.1.6-x64.exe"
    ]
  },
  "dataPack": {
    "includedInMainInstaller": false,
    "plannedAsSeparateArtifact": true,
    "artifact": "dist-installer/data-pack-0.1.0",
    "installerArtifact": "dist-installer/掌财桌面端-日线数据包-0.1.0-x64.exe",
    "installTarget": "selected-client-directory\\data\\resource-library",
    "clientDirectorySelection": "required-for-client-validation-and-recording"
  },
  "frontend": {
    "primaryPort": 34303,
    "primaryRoute": "/",
    "chatRoute": "/chat",
    "legacyChatPort": 3004,
    "recommendedMode": "single-frontend-process",
    "note": "Desktop uses one production frontend for / and /chat; 3003/3004 remain web-test ports only."
  },
  "bridge": {
    "host": "127.0.0.1",
    "port": 44319,
    "legacyWebPort": 4319,
    "entry": "agent-server.mjs",
    "dataMode": "user-writable",
    "tdxMode": "user-selected-external-install"
  },
  "runtime": {
    "node": "24.19.0",
    "python": "3.12.14",
    "nodeEngine": ">=22.13.0",
    "vinext": "1.0.0-beta.5",
    "harness": {
      "requiredForRelease": true,
      "bundledPath": "resources/deepseek-harness/lib/bin.js",
      "currentWorkspaceStatus": "rebuilt-after-runtime-prune-fix",
      "policy": "pin-and-bundle-in-main-installer; do-not-rebuild-unless-baseline-changes"
    }
  },
  "data": {
    "developmentRoot": "app-data",
    "packagedRoot": "<client-install-root>\\data\\resource-library",
    "doNotPackage": [".env.local", "DEEPSEEK_API_KEY", "C:\\new_tdx_mock"],
    "preserveOnUninstall": true
  },
  "installer": {
    "desktopShell": "Electron",
    "windowsInstaller": "electron-builder + NSIS",
    "architecture": "x64",
    "tdxDistribution": "user-download-and-select",
    "dataDistribution": "self-contained-nsis-data-installer",
    "installerIcon": "electron-app/resources/installer-icon.ico",
    "dataPackIcon": "packaging/data-pack-icon.png",
    "dataPackInstallerIcon": "packaging/data-pack-icon.ico",
    "dataPolicy": "local_first_on_demand",
    "publicFallback": "TDX unavailable -> download explicit-date public daily/market/news snapshots into the local resource library, mark degraded, then let Harness validate",
    "legacyEnvironmentInstaller": "scripts/package-environment.ps1",
    "legacyEnvironmentUninstaller": "electron-app/nsis/environment-uninstaller.nsi"
  }
}
