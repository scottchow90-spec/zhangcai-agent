{
  "name": "zhangcai-agent",
  "version": "0.1.22",
  "private": true,
  "description": "掌财 4319 本地股票研究桌面程序",
  "author": {
    "name": "Zhangcai"
  },
  "main": "electron-app/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --host 127.0.0.1 --port 3003",
    "dev:chat": "vinext dev --host 127.0.0.1 --port 3004",
    "dev:lan": "vinext dev --host 0.0.0.0 --port 3003",
    "dev:local": "vinext dev --hostname 127.0.0.1 --port 3003",
    "agent:dev": "node agent-server.mjs",
    "stock:quick": "node quick-stock-server.mjs",
    "build": "vinext build",
    "start": "vinext start --hostname 127.0.0.1 --port 3003",
    "start:chat": "vinext start --hostname 127.0.0.1 --port 3004",
    "prepare:runtime": "node scripts/prepare-runtime-assets.mjs",
    "prepare:skill14": "node scripts/skill14-runtime.mjs prepare-packages",
    "data:archive": "node scripts/skill14-runtime.mjs archive-daily",
    "start:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "package:preflight": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-preflight.ps1 -MainInstaller",
    "package:build:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-win.ps1",
    "package:build:win:dir": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-win-dir.ps1",
    "package:build:win:environment": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-environment.ps1",
    "package:build:win:update": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-program-update.ps1",
    "prepare:desktop-exe-data": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-exe-data.ps1",
    "package:data": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-data-pack.ps1",
    "package:data:icon": "node scripts/convert-data-pack-icon.mjs",
    "package:data:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-data-installer.ps1",
    "verify:desktop-ports": "node scripts/test-desktop-ports.mjs",
    "verify:desktop-exe": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-electron-exe.ps1",
    "verify:desktop-exe:data": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-electron-exe.ps1 -UseExeDataSeed",
    "verify:served-assets": "node scripts/verify-served-assets.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
