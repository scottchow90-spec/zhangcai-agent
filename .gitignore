# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
.dsh*/
.tmp-interface-skill/

# deployment and generated files
.vercel
# next-env.d.ts is a portable TypeScript source input; keep it tracked.
/dist/
/.wrangler/
/outputs/
/work/

# Runtime research data is user-local and must never be packaged as source.
/data/runtime/
/data/public/
/data/reports/
/data/logs/
/data/news/
/data/harness/
!/data/runtime/.gitkeep
!/data/public/.gitkeep
!/data/reports/.gitkeep
!/data/logs/.gitkeep
!/data/news/.gitkeep
!/data/harness/.gitkeep

# Local runtime state, generated reports, builds, and caches
/.cache/
/.runtime/
**/.runtime/
/.dsh/
/.dsh-bridge/
/.next/
/.vinext/
/.wrangler/
/dist/
/runtime-results/
/reports/
/**/reports/
/data/strategy-results/
/app-data/
/skill-archives/*
!/skill-archives/*.zip
/data/dev-server*.log
**/__pycache__/
*.log

# Verified frontend staging is a local packaging input, not recovered source.
/packaging/staging/

# Reproducible source checkout; binaries are supplied as hash-locked LFS assets.
/dist-installer/
/packaging/runtime-node-modules/
/packaging/vendor/
/packaging/dist-backup*/
/packaging/.incremental*/
*.tsbuildinfo
*.pyc
*.pyo
/.bootstrap-*/
/.tmp*
/_probe*
/_task*
/_scan*
/_extract*
/_prior_job_output*
/.dev-tools/
!.env.example
