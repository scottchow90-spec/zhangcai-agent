LC:=REF(CLOSE,1);
V6:=CLOSE/REF(CLOSE,3)>=1.1;
V7:=BACKSET(V6,4);
LS:=C/REF(C,1)>1.040 AND C=H AND BETWEEN(FORCAST(V,4),0.2*FORCAST(V,12),2.1*FORCAST(V,5));
VAR26:=EMA(CLOSE,2)-EMA(CLOSE,150);
VAR27:=EMA(VAR26,100);
VAR28:=2*(VAR26-VAR27);
VAR29:=POW(VAR28,3)*0.1+POW(VAR28,1);
买入原始:=ZIG(3,10)>REF(ZIG(3,10),1) AND REF(ZIG(3,10),1)<REF(ZIG(3,10),2);
最佳买入:买入原始,COLORRED,LINETHICK2;
DRAWTEXT(买入原始,40,'白猫抄底'),COLORRED;
V6R:=CLOSE/REF(CLOSE,3)<=0.9;
V7R:=BACKSET(V6R,4);
LSR:=C/REF(C,1)<0.96 AND C=L AND VOL>2.1*MA(VOL,5);
VAR26R:=EMA(CLOSE,150)-EMA(CLOSE,2);
VAR27R:=EMA(VAR26R,100);
VAR28R:=2*(VAR26R-VAR27R);
VAR29R:=POW(VAR28R,3)*0.1+POW(VAR28R,1);
卖出原始:=ZIG(3,10)<REF(ZIG(3,10),1) AND REF(ZIG(3,10),1)>REF(ZIG(3,10),2);
MA5:=MA(C,5);
MA10:=MA(C,10);
MA60:=MA(C,60);
空头排列:=MA5<MA10 AND MA10<MA60;
最佳卖出:卖出原始 AND 空头排列,COLORGREEN,LINETHICK2;
DRAWTEXT(卖出原始 AND 空头排列,40,'黑猫逃顶'),COLORGREEN;


